# Copie para .env no seu computador. Nunca publique o arquivo .env.
# No Neon: Connect > Node.js > copie a connection string do seu banco.
DATABASE_URL=postgresql://USUARIO:SENHA@SEU-ENDPOINT-pooler.REGIAO.aws.neon.tech/neondb?sslmode=verify-full
ADMIN_USER=admin
# Escolha uma senha exclusiva de pelo menos 12 caracteres.
ADMIN_PASSWORD=
PORT=3000
NODE_ENV=development
# No Render esta URL é detectada automaticamente. Para domínio próprio, defina APP_URL.
APP_URL=http://localhost:3000
